rules_version = '2';

// Plan Spark: no hay servidor. La web lee y escribe directo, y estas reglas
// son la única barrera: cada escritura que la web hace tiene que pasar por acá.
// Modelo completo: docs/firestore-modelo.md.
//
// Staff de un torneo = su organizador o un uid de `admin_ids`.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ utilidades

    function conSesion() {
      return request.auth != null;
    }

    function yo() {
      return request.auth.uid;
    }

    /** Solo cambian estos campos respecto del documento guardado. */
    function soloCambian(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function textoOpcional(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function enteroEntre(v, min, max) {
      return v is int && v >= min && v <= max;
    }

    function urlHttp(v) {
      return v is string && v.size() >= 8 && v.size() <= 500 && v.matches('https?://[^\\s]+');
    }

    function vodLinkValido(v) {
      return v is map && v.keys().hasAll(['label', 'url']) && v.keys().hasOnly(['label', 'url'])
        && texto(v.label, 1, 60) && urlHttp(v.url);
    }

    function vodLinksValidos(links) {
      return links is list && links.size() <= 20
        && (links.size() < 1 || vodLinkValido(links[0]))
        && (links.size() < 2 || vodLinkValido(links[1]))
        && (links.size() < 3 || vodLinkValido(links[2]))
        && (links.size() < 4 || vodLinkValido(links[3]))
        && (links.size() < 5 || vodLinkValido(links[4]))
        && (links.size() < 6 || vodLinkValido(links[5]))
        && (links.size() < 7 || vodLinkValido(links[6]))
        && (links.size() < 8 || vodLinkValido(links[7]))
        && (links.size() < 9 || vodLinkValido(links[8]))
        && (links.size() < 10 || vodLinkValido(links[9]))
        && (links.size() < 11 || vodLinkValido(links[10]))
        && (links.size() < 12 || vodLinkValido(links[11]))
        && (links.size() < 13 || vodLinkValido(links[12]))
        && (links.size() < 14 || vodLinkValido(links[13]))
        && (links.size() < 15 || vodLinkValido(links[14]))
        && (links.size() < 16 || vodLinkValido(links[15]))
        && (links.size() < 17 || vodLinkValido(links[16]))
        && (links.size() < 18 || vodLinkValido(links[17]))
        && (links.size() < 19 || vodLinkValido(links[18]))
        && (links.size() < 20 || vodLinkValido(links[19]));
    }

    function rutaTorneo(slug) {
      return /databases/$(database)/documents/tournaments/$(slug);
    }

    function rutaEquipo(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function esStaffDe(t) {
      return conSesion() && (t.organizer_id == yo() || yo() in t.get('admin_ids', []));
    }

    function esStaff(slug) {
      return esStaffDe(get(rutaTorneo(slug)).data);
    }

    function inscripcionAbierta(t) {
      return t.status in ['inscripcion', 'armado'];
    }

    // -------------------------------------------------------------- usuarios

    // Lo que el dueño puede escribir de su perfil. `is_admin` no está.
    function camposDePerfil() {
      return ['display_name', 'display_name_lower', 'avatar_url', 'timezone', 'discord', 'xbox_tag',
              'rating_1v1', 'rating_team'];
    }

    function ratingValido(v) {
      return v == null || enteroEntre(v, 0, 5000);
    }

    function perfilValido(d) {
      return texto(d.display_name, 1, 60)
        && d.display_name_lower == d.display_name.lower()
        && textoOpcional(d.get('avatar_url', null), 500)
        && textoOpcional(d.get('timezone', null), 60)
        && textoOpcional(d.get('discord', null), 200)
        && textoOpcional(d.get('xbox_tag', null), 200)
        && ratingValido(d.get('rating_1v1', null))
        && ratingValido(d.get('rating_team', null));
    }

    match /users/{userId} {
      // Perfil público: lo ven todos (nombres en llaves, equipos y chat).
      allow read: if true;
      allow create: if conSesion() && yo() == userId
        && request.resource.data.keys().hasOnly(camposDePerfil().concat(['created_at', 'is_admin']))
        && request.resource.data.get('is_admin', 0) == 0
        && perfilValido(request.resource.data);
      allow update: if conSesion() && yo() == userId
        && soloCambian(camposDePerfil())
        && perfilValido(request.resource.data);
      allow delete: if false;

      // Datos que solo ve el dueño (por ejemplo el email de Google).
      match /privado/{doc} {
        allow read, write: if conSesion() && yo() == userId;
      }
    }

    // --------------------------------------------------------------- torneos

    function torneoValido(d) {
      return texto(d.name, 1, 120)
        && d.status in ['borrador', 'inscripcion', 'armado', 'en_curso', 'finalizado', 'cancelado']
        && d.team_size in [1, 2, 3, 4]
        && d.get('admin_ids', []) is list && d.get('admin_ids', []).size() <= 10
        && enteroEntre(d.get('civ_bans', 0), 0, 3)
        && enteroEntre(d.get('best_of', 1), 1, 9);
    }

    match /tournaments/{slug} {
      allow read: if true;
      allow create: if conSesion()
        && request.resource.data.organizer_id == yo()
        && request.resource.data.slug == slug
        && torneoValido(request.resource.data);
      // Los admins editan todo menos el organizador y la lista de admins.
      allow update: if esStaffDe(resource.data)
        && request.resource.data.organizer_id == resource.data.organizer_id
        && request.resource.data.slug == slug
        && (resource.data.organizer_id == yo()
            || request.resource.data.get('admin_ids', []) == resource.data.get('admin_ids', []))
        && torneoValido(request.resource.data);
      allow delete: if esStaffDe(resource.data);

      // Etapas (grupos, suizo): las genera el staff desde su navegador.
      match /stages/{stageId} {
        allow read: if true;
        allow create, update: if esStaff(slug)
          && (!request.resource.data.keys().hasAny(['vod_links'])
              || vodLinksValidos(request.resource.data.vod_links));
        allow delete: if esStaff(slug);
      }

      // ------------------------------------------------- rondas y sus horarios
      //
      // Cada ronda del cuadro tiene sus fechas, que fija el staff, y adentro los
      // horarios de cada jugador para esa ronda, cada uno el suyo. La clave de la
      // ronda es `{stage_id}_{bracket}{round}` (web/src/logica/rondas.js). Las
      // reglas no tienen bucles: de los horarios se valida el tope y la forma, no
      // cada bloque; la web recorta lo que cae fuera del rango al leer.

      function rutaRonda(rondaId) {
        return /databases/$(database)/documents/tournaments/$(slug)/rondas/$(rondaId);
      }

      function rondaValida(d) {
        return d.keys().hasOnly(['stage_id', 'bracket', 'round', 'label', 'from_day', 'to_day', 'zone',
                                 'starts_at', 'ends_at', 'updated_at'])
          && d.keys().hasAll(['stage_id', 'bracket', 'round', 'from_day', 'to_day', 'zone', 'starts_at', 'ends_at'])
          && texto(d.stage_id, 1, 40)
          && d.bracket in ['W', 'L', 'F']
          && enteroEntre(d.round, 1, 64)
          && textoOpcional(d.get('label', null), 60)
          && texto(d.from_day, 10, 10) && texto(d.to_day, 10, 10)
          && texto(d.zone, 1, 60)
          && texto(d.starts_at, 20, 30) && texto(d.ends_at, 20, 30)
          && d.starts_at < d.ends_at;
      }

      // Hasta 800 bloques: 31 días de barras alternadas son 744.
      function horarioValido(d, userId) {
        return d.keys().hasOnly(['user_id', 'blocks', 'updated_at'])
          && d.keys().hasAll(['user_id', 'blocks'])
          && d.user_id == userId
          && d.blocks is list && d.blocks.size() <= 800;
      }

      match /rondas/{rondaId} {
        allow read: if true;
        allow create, update: if esStaff(slug) && rondaValida(request.resource.data);
        allow delete: if esStaff(slug);

        match /horarios/{userId} {
          allow read: if true;
          // Solo en una ronda que ya tiene fechas, y solo inscripto y sin retirarse.
          allow create, update: if conSesion() && yo() == userId
            && inscriptoVigente(slug)
            && exists(rutaRonda(rondaId))
            && horarioValido(request.resource.data, userId);
          // Al regenerar las llaves el staff los borra con la ronda.
          allow delete: if conSesion() && (yo() == userId || esStaff(slug));
        }
      }

      // ---------------------------------------------------------- inscripciones

      // Equipo del torneo que, después de esta escritura, incluye al usuario.
      function equipoConmigo(teamId) {
        return teamId == null || (
          getAfter(rutaEquipo(teamId)).data.tournament_id == slug
          && yo() in getAfter(rutaEquipo(teamId)).data.member_ids);
      }

      // Suelto sin equipo, o con equipo; nunca mitad y mitad.
      function equipoCoherente(d) {
        return (d.team_id == null) == (d.kind == 'solo');
      }

      function altaPropia(userId) {
        let d = request.resource.data;
        let t = get(rutaTorneo(slug)).data;
        return yo() == userId
          && inscripcionAbierta(t)
          && d.keys().hasOnly(['user_id', 'team_id', 'kind', 'status', 'paid', 'paid_at', 'payment_ref', 'note', 'created_at'])
          && d.user_id == userId
          && d.status == 'pendiente'
          && d.paid == 0 && d.paid_at == null && d.payment_ref == null
          && d.kind in ['solo', 'equipo']
          && (d.kind == 'equipo' || t.team_size == 1 || t.allow_solo == 1)
          && equipoCoherente(d)
          && equipoConmigo(d.team_id)
          && textoOpcional(d.note, 500);
      }

      // El dueño se retira, vuelve (si estaba retirado y está abierto) o
      // cambia de equipo. Pago, estado del staff y nota del staff no los toca.
      function cambioPropio(userId) {
        let d = request.resource.data;
        let r = resource.data;
        return yo() == userId
          && soloCambian(['status', 'kind', 'team_id', 'note'])
          && (d.status == r.status
              || d.status == 'retirada'
              || (r.status == 'retirada' && d.status == 'pendiente' && inscripcionAbierta(get(rutaTorneo(slug)).data)))
          && (d.status == 'retirada'
              ? d.team_id == null
              : (equipoCoherente(d) && equipoConmigo(d.team_id)))
          && textoOpcional(d.note, 500);
      }

      // El capitán suma a alguien a su equipo o lo saca.
      function cambioDeCapitan(userId) {
        let d = request.resource.data;
        let r = resource.data;
        return conSesion()
          && soloCambian(['team_id', 'kind'])
          && (d.team_id == null
              ? (r.team_id != null && d.kind == 'solo'
                 && get(rutaEquipo(r.team_id)).data.captain_id == yo())
              : (d.kind == 'equipo'
                 && getAfter(rutaEquipo(d.team_id)).data.tournament_id == slug
                 && getAfter(rutaEquipo(d.team_id)).data.captain_id == yo()
                 && userId in getAfter(rutaEquipo(d.team_id)).data.member_ids));
      }

      match /registrations/{userId} {
        allow read: if true;
        allow create: if esStaff(slug) || (conSesion() && altaPropia(userId));
        allow update: if esStaff(slug) || (conSesion() && cambioPropio(userId)) || cambioDeCapitan(userId);
        allow delete: if esStaff(slug);
      }
    }

    // --------------------------------------------------------------- equipos

    function equipoValido(d, t) {
      return texto(d.name, 1, 60)
        && textoOpcional(d.get('tag', null), 8)
        && textoOpcional(d.get('logo_url', null), 500)
        && d.member_ids is list && d.members is list
        && d.members.size() == d.member_ids.size()
        && d.member_ids.size() <= t.team_size
        && (d.captain_id == null || d.captain_id in d.member_ids);
    }

    // Un jugador crea su equipo con él solo, como capitán.
    function equipoNuevoPropio(d, t) {
      return inscripcionAbierta(t)
        && d.keys().hasOnly(['tournament_id', 'name', 'tag', 'logo_url', 'captain_id', 'seed', 'auto_built',
                             'created_at', 'members', 'member_ids'])
        && d.captain_id == yo()
        && d.member_ids == [yo()]
        && d.members == [{ 'user_id': yo(), 'role': 'capitan' }]
        && d.get('seed', null) == null
        && d.get('auto_built', 0) == 0;
    }

    // Un jugador se suma solo a un equipo con lugar.
    function meSumo(r, d, t) {
      return inscripcionAbierta(t)
        && soloCambian(['members', 'member_ids'])
        && !(yo() in r.member_ids)
        && d.member_ids == r.member_ids.concat([yo()])
        && d.members == r.members.concat([{ 'user_id': yo(), 'role': 'jugador' }]);
    }

    // Un jugador se va de su equipo.
    function meVoy(r, d) {
      return soloCambian(['members', 'member_ids'])
        && yo() in r.member_ids
        && d.member_ids == r.member_ids.removeAll([yo()])
        && d.members == r.members.removeAll([{ 'user_id': yo(), 'role': 'jugador' },
                                             { 'user_id': yo(), 'role': 'capitan' }]);
    }

    match /teams/{teamId} {
      allow read: if true;

      allow create: if conSesion()
        && (esStaff(request.resource.data.tournament_id)
            || equipoNuevoPropio(request.resource.data, get(rutaTorneo(request.resource.data.tournament_id)).data))
        && equipoValido(request.resource.data, get(rutaTorneo(request.resource.data.tournament_id)).data);

      // Seed y `auto_built` solo los cambia el staff.
      allow update: if conSesion()
        && request.resource.data.tournament_id == resource.data.tournament_id
        && (esStaff(resource.data.tournament_id)
            || (resource.data.captain_id == yo()
                && soloCambian(['name', 'tag', 'logo_url', 'captain_id', 'members', 'member_ids']))
            || meSumo(resource.data, request.resource.data, get(rutaTorneo(resource.data.tournament_id)).data)
            || meVoy(resource.data, request.resource.data))
        && equipoValido(request.resource.data, get(rutaTorneo(resource.data.tournament_id)).data);

      // Se borra con el staff, o cuando se va el último que quedaba.
      allow delete: if conSesion()
        && (esStaff(resource.data.tournament_id) || resource.data.member_ids == [yo()]);
    }

    // -------------------------------------------------------------- partidos

    function rutaPartido(matchId) {
      return /databases/$(database)/documents/matches/$(matchId);
    }

    function rutaUsuario(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    /** ¿Juega en alguno de los dos equipos del partido? */
    function juegaElPartido(m) {
      return conSesion() && (
        (m.team_a_id != null && yo() in get(rutaEquipo(m.team_a_id)).data.member_ids)
        || (m.team_b_id != null && yo() in get(rutaEquipo(m.team_b_id)).data.member_ids));
    }

    /** ¿Es capitán de alguno de los dos equipos del partido? */
    function capitanDelPartido(m) {
      return conSesion() && (
        (m.team_a_id != null && get(rutaEquipo(m.team_a_id)).data.captain_id == yo())
        || (m.team_b_id != null && get(rutaEquipo(m.team_b_id)).data.captain_id == yo()));
    }

    match /matches/{matchId} {
      allow read: if true;
      // Las llaves y los resultados los escribe el staff desde su navegador.
      allow create: if esStaff(request.resource.data.tournament_id)
        && (!request.resource.data.keys().hasAny(['vod_links'])
            || vodLinksValidos(request.resource.data.vod_links));
      allow delete: if esStaff(resource.data.tournament_id);
      // Los capitanes solo agendan (pendiente pasa a agendado). Los links, solo el staff.
      allow update: if request.resource.data.tournament_id == resource.data.tournament_id
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vod_links'])
            || (esStaff(resource.data.tournament_id) && vodLinksValidos(request.resource.data.vod_links)))
        && (esStaff(resource.data.tournament_id)
            || (capitanDelPartido(resource.data)
                && soloCambian(['scheduled_at', 'status'])
                && (request.resource.data.status == resource.data.status
                    || (resource.data.status == 'pendiente' && request.resource.data.status == 'agendado'))));

      // Votos de horario: un documento por jugador, con sus votos.
      match /votos/{userId} {
        allow read: if true;
        allow write: if conSesion() && yo() == userId
          && (juegaElPartido(get(rutaPartido(matchId)).data)
              || esStaff(get(rutaPartido(matchId)).data.tournament_id))
          && request.resource.data.keys().hasOnly(['votes'])
          && request.resource.data.votes is list
          && request.resource.data.votes.size() <= 50;
        // Al regenerar las llaves, el staff borra el partido con sus votos.
        allow delete: if esStaff(get(rutaPartido(matchId)).data.tournament_id);
      }

      // ---------------------------------------------------------------- draft
      //
      // drafts/{gameNo} guarda lo que arma `planDeDraft` (web/src/logica/draft.js).
      // Un jugador del partido lo crea; después cada uno solo puede dar el paso
      // que le toca: elegir mapa, banear, anotarse como que ya eligió, revelar.

      function partidaAnteriorConGanador(m, gameNo) {
        return gameNo == 1 || m.games[gameNo - 2].winner_team_id != null;
      }

      function draftNuevoValido(d, m, gameNo) {
        return d.game_no == gameNo
          && d.team_a_id == m.team_a_id && d.team_b_id == m.team_b_id
          && d.revealed == false
          && d.state in ['mapa', 'bans', 'picks']
          && d.banned_civ_ids == []
          && d.get('picked', []) == []
          && d.player_ids is list && d.player_ids.size() >= 2 && d.player_ids.size() <= 8;
      }

      function equipoEnElDraft(d) {
        return yo() in d.team_of ? d.team_of[yo()] : null;
      }

      function eligeMapa(r, d) {
        return r.state == 'mapa'
          && soloCambian(['map_id', 'state'])
          && equipoEnElDraft(r) == r.map_chooser_team_id
          && d.map_id in r.map_pool
          && d.state == (r.ban_order.size() > 0 ? 'bans' : 'picks');
      }

      function banea(r, d) {
        let n = r.banned_civ_ids.size();
        let civ = d.banned_civ_ids[n];
        return r.state == 'bans'
          && soloCambian(['banned_civ_ids', 'state'])
          && equipoEnElDraft(r) == r.ban_order[n]
          && d.banned_civ_ids.size() == n + 1
          && d.banned_civ_ids == r.banned_civ_ids.concat([civ])
          && civ in r.civ_pool
          && !(civ in r.banned_civ_ids)
          && d.state == (n + 1 == r.ban_order.size() ? 'picks' : 'bans');
      }

      // Se anota en `picked` en el mismo batch en que guarda su pick.
      function seAnota(r, d, gameNo) {
        return r.state == 'picks' && !r.revealed
          && soloCambian(['picked'])
          && yo() in r.player_ids
          && !(yo() in r.get('picked', []))
          && d.picked == r.get('picked', []).concat([yo()])
          && existsAfter(/databases/$(database)/documents/matches/$(matchId)/drafts/$(gameNo)/picks/$(yo()));
      }

      // Cualquiera que juega revela cuando están anotados todos.
      function revela(r, d) {
        return r.state == 'picks' && !r.revealed
          && soloCambian(['revealed', 'state'])
          && d.revealed == true && d.state == 'listo'
          && yo() in r.player_ids
          && r.get('picked', []).toSet().hasAll(r.player_ids);
      }

      match /drafts/{gameNo} {
        allow read: if true;
        allow create: if conSesion()
          && (juegaElPartido(get(rutaPartido(matchId)).data)
              || esStaff(get(rutaPartido(matchId)).data.tournament_id))
          && partidaAnteriorConGanador(get(rutaPartido(matchId)).data, int(gameNo))
          && draftNuevoValido(request.resource.data, get(rutaPartido(matchId)).data, int(gameNo));
        allow update: if conSesion()
          && (esStaff(get(rutaPartido(matchId)).data.tournament_id)
              || eligeMapa(resource.data, request.resource.data)
              || banea(resource.data, request.resource.data)
              || seAnota(resource.data, request.resource.data, gameNo)
              || revela(resource.data, request.resource.data));
        // Reiniciar el draft: el staff lo borra (sin reloj, D11).
        allow delete: if esStaff(get(rutaPartido(matchId)).data.tournament_id);

        function rutaDraft() {
          return /databases/$(database)/documents/matches/$(matchId)/drafts/$(gameNo);
        }

        // Pick ciego: el ajeno no se lee hasta que el draft se revela.
        match /picks/{userId} {
          allow read: if (conSesion() && yo() == userId) || get(rutaDraft()).data.revealed == true;
          allow create, update: if conSesion() && yo() == userId
            && pickValido(get(rutaDraft()).data, userId, request.resource.data);
          allow delete: if esStaff(get(rutaPartido(matchId)).data.tournament_id);
        }

        function pickValido(d, userId, p) {
          return d.state == 'picks' && d.revealed == false
            && userId in d.player_ids
            && p.keys().hasOnly(['civ_id'])
            && p.civ_id in d.civ_pool
            && !(p.civ_id in d.banned_civ_ids)
            && !(p.civ_id in d.civs_usadas.get(userId, []));
        }
      }
    }

    // ------------------------------------------------------------------ chat
    //
    // rooms/torneo_{slug} (pública), rooms/partido_{matchId} (pública) y
    // rooms/equipo_{teamId} (sus miembros y el staff). La sala de equipo no
    // guarda quién la lee: sale del equipo, así no hay que mantenerlo al día.

    function rutaSala(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function puedeLeerSala(sala) {
      return sala.kind != 'equipo' || (conSesion() && (
        yo() in get(rutaEquipo(sala.team_id)).data.member_ids || esStaff(sala.tournament_id)));
    }

    function inscriptoVigente(slug) {
      let ruta = /databases/$(database)/documents/tournaments/$(slug)/registrations/$(yo());
      return exists(ruta) && get(ruta).data.status != 'retirada';
    }

    function puedeEscribirSala(sala) {
      return conSesion() && (
        esStaff(sala.tournament_id)
        || (sala.kind == 'torneo' && inscriptoVigente(sala.tournament_id))
        || (sala.kind == 'partido' && juegaElPartido(get(rutaPartido(sala.match_id)).data))
        || (sala.kind == 'equipo' && yo() in get(rutaEquipo(sala.team_id)).data.member_ids));
    }

    // La sala la crea quien la abre primero, con los datos que salen de su id.
    function salaNuevaValida(roomId, s) {
      return s.keys().hasOnly(['kind', 'tournament_id', 'match_id', 'team_id', 'name', 'public_read', 'readers', 'created_at'])
        && textoOpcional(s.get('name', null), 120)
        && (
          (s.kind == 'torneo' && roomId == 'torneo_' + s.tournament_id
            && s.public_read == true && exists(rutaTorneo(s.tournament_id)))
          || (s.kind == 'partido' && roomId == 'partido_' + s.match_id && s.public_read == true
            && get(rutaPartido(s.match_id)).data.tournament_id == s.tournament_id)
          || (s.kind == 'equipo' && roomId == 'equipo_' + s.team_id && s.public_read == false
            && get(rutaEquipo(s.team_id)).data.tournament_id == s.tournament_id));
    }

    match /rooms/{roomId} {
      allow read: if puedeLeerSala(resource.data);
      allow create: if conSesion() && salaNuevaValida(roomId, request.resource.data);
      allow update: if false;
      allow delete: if esStaff(resource.data.tournament_id);

      // Mensajes: el autor va copiado tal como está en su perfil, y desde el
      // cliente nunca son del sistema.
      match /messages/{mensaje} {
        allow read: if puedeLeerSala(get(rutaSala(roomId)).data);
        allow create: if exists(rutaSala(roomId))
          && puedeEscribirSala(get(rutaSala(roomId)).data)
          && mensajeValido(request.resource.data);
        allow update: if false;
        allow delete: if esStaff(get(rutaSala(roomId)).data.tournament_id);
      }
    }

    function mensajeValido(m) {
      let perfil = get(rutaUsuario(yo())).data;
      return m.keys().hasOnly(['body', 'system', 'created_at', 'user'])
        && texto(m.body, 1, 2000)
        && m.system == 0
        && m.created_at == request.time
        && m.user == { 'id': yo(), 'display_name': perfil.display_name, 'avatar_url': perfil.get('avatar_url', null) };
    }

  }
}
